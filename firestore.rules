rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    match /student_accounts/{docId} {
      allow read, write: if true;
    }

    match /students/{docId} {
      allow read, write: if true;
    }

    match /progress/{docId} {
      allow read, write: if true;
    }

    match /attempts/{docId} {
      allow read, write: if true;
    }

    match /mission_results/{docId} {
      allow read, write: if true;
    }

    match /evidences/{docId} {
      allow read, write: if true;
    }

    match /assessments/{docId} {
      allow read, write: if true;
    }

    match /ai_logs/{docId} {
      allow read, write: if true;
    }

    match /teacher_mappings/{docId} {
      allow read, write: if true;
    }
  }
}
